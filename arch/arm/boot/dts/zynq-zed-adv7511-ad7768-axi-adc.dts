	axi_spi_engine_0: spi@42000000 {
		compatible = "adi,axi-spi-engine-1.00.a";
		reg = <0x42000000 0x40000>;
		interrupt-parent = <&intc>;
		interrupts = <0 52 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc 15 &clkc 15>;
		clock-names = "s_axi_aclk", "spi_clk";
		num-cs = <1>;

		#address-cells = <0x1>;
		#size-cells = <0x0>;
		ad5791: dac@0 {
			compatible = "adi,ad5791";
			reg = <0>;
			spi-max-frequency = <25000000>;
	//		spi-cpha;
			spi-cpol;
			vss-supply = <&vdac>; /* probably needs to be vdac 5.0V */
			vdd-supply = <&vref>;	
			dmas = <&tx_dma 0>;
			dma-names = "tx";	
		
		};		
	};
	
	axi_spi_engine_1: spi@44a40000 {
		compatible = "adi,axi-spi-engine-1.00.a";
		reg = <0x44a40000 0x10000>;
		interrupt-parent = <&intc>;
		interrupts = <0 35 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc 15 &clkc 15>;
		clock-names = "s_axi_aclk", "spi_clk";
		num-cs = <1>;

		#address-cells = <0x1>;
		#size-cells = <0x0>;	
		
		ad5541a: cola@0 {
			compatible = "adi,ad5541a";
			reg = <0>;
			spi-max-frequency = <25000000>; 
			spi-cpha;
			spi-cpol;
			vcc-supply = <&vref>;	
			dmas = <&cola_dma 0>;
			dma-names = "tx";		
		};
	};
};



&spi0 {
	status = "okay";

	ad7768: adc@0 {
		compatible = "adi,ad7768";
		reg = <0>;
		spi-max-frequency = <1000000>;
		interrupt-parent = <&intc>;
		interrupts = <0 56 IRQ_TYPE_LEVEL_LOW>;
		vref-supply = <&vref>;
		reset-gpios = <&gpio0 86 GPIO_ACTIVE_LOW>;
	/*	start-gpios = <&gpio0 87 GPIO_ACTIVE_HIGH>; uncomment for eval board */
		clocks = <&ad7768_mclk>;
		clock-names = "mclk";
		adi,data-lines = <8>;		
	};
};

&usb0 {
	dr_mode = "otg";
};

/* HDMI/audio subsystem removed from the PL fabric (Panther15 HDMI-removal
 * build, 2026-07-10). The adv7511/adau1761 chips remain on I2C but their
 * drivers are disabled; the axi_hdmi/spdif/i2s/clkgen cores no longer exist
 * in the bitstream. Shared zynq-zed-adv7511.dtsi is intentionally untouched. */
&adv7511 { status = "disabled"; };
&adau1761 { status = "disabled"; };
&hdmi_dma { status = "disabled"; };
&hdmi_clock { status = "disabled"; };
&axi_spdif_tx_0 { status = "disabled"; };
&axi_i2s_0 { status = "disabled"; };

&fpga_axi {
	axi_hdmi@70e00000 { status = "disabled"; };
};

/ {
	adv7511_hdmi_snd { status = "disabled"; };
	zed_sound { status = "disabled"; };
};
